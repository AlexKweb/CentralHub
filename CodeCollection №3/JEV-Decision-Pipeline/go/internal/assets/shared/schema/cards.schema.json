{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jev/cards.schema.json",
  "title": "JEV card catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "columns"],
  "properties": {
    "version": { "const": 1 },
    "columns": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "num", "title", "color", "cards"],
        "properties": {
          "id": { "enum": ["state", "questions", "jev", "gate", "code"] },
          "num": { "type": "string", "pattern": "^0[1-5]$" },
          "title": { "type": "string", "pattern": "^[A-Z]+ / [A-Z ]+$" },
          "color": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
          "cards": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "rows"],
              "properties": {
                "id": { "type": "string", "pattern": "^[sqjgc]\\.[a-z_]+$" },
                "title": { "type": "string", "minLength": 1 },
                "rows": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["k", "v"],
                    "properties": {
                      "k": { "type": "string", "minLength": 1 },
                      "v": { "type": "string", "minLength": 1 },
                      "hl": { "const": true }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
